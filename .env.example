# Which model to use, as provider/model. Pick one:
LLM_MODEL=anthropic/claude-sonnet-5-5
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001   # cheaper, fine for simple pages
# LLM_MODEL=openai/gpt-5-mini
# LLM_MODEL=ollama/llama3.2                        # local, free, no key (run `ollama serve`)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the context size scrape.py assumes for the model.
# LLM_MODEL_TOKENS=200000
# OLLAMA_BASE_URL=http://localhost:11434

# Only for the HTTP API (app.py): callers must send "Authorization: Bearer <API_TOKEN>".
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKEN=
